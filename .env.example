# Copy to .env (git-ignored) and `set -a; . ./.env; set +a` before running.
MITSUBISHI_COMFORT_EMAIL=you@example.com
MITSUBISHI_COMFORT_PASSWORD=change-me
MSC_DEVICE=YOUR-UNIT-SERIAL-OR-NAME
# MSC_SENSOR_NAME=
# MSC_LATITUDE=
# MSC_LONGITUDE=
# MSC_DATA_DIR=./var
# MSC_CONFIG=./config.toml
# MSC_TIMEZONE=America/Los_Angeles
# MSC_SKIP_RECENT_S=300      # loop skips its cycle if another cycle ran this recently
# MSC_KICK_STALE_S=720       # scripts/kick.sh: heartbeat age that triggers one cycle
# MSC_KICK_TIMEOUT_S=420     # scripts/kick.sh: hard timeout for that cycle (> MSC_KICK_WATCHDOG_S + 10)
# MSC_KICK_WATCHDOG_S=360    # scripts/kick.sh: keep equal to cycle_watchdog_s
# MSC_KICK_RESTART_CMD=scripts/run_loop.sh 0   # with systemd: systemctl --user restart minisplit-loop.service
# MSC_KICK_PYTHON=python3    # e.g. .venv/bin/python
